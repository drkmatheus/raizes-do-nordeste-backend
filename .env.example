# --- Banco (docker compose) ---
POSTGRES_USER=raizes
POSTGRES_PASSWORD=raizes123
POSTGRES_DB=raizes
POSTGRES_PORT=5432

# --- pgAdmin (docker compose) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# --- API ---
# Se mudar usuario, senha, banco ou porta acima, ajuste a URL tambem.
DATABASE_URL=postgresql+psycopg://raizes:raizes123@localhost:5432/raizes
# Gere uma chave propria: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-com-mais-de-32-caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
