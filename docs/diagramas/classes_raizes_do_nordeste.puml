@startuml classes_raizes_do_nordeste
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 150
skinparam classFontSize 12
hide empty members

title Diagrama de Classes - Dominio (Raizes do Nordeste)

class Usuario {
  +id : int
  +nome : string
  +email : string
  -senhaHash : string
  +perfil : Perfil
  +saldoPontos : int
  +consentimentoFidelidade : bool
  +podeResgatar() : bool
  +acumularPontos(pontos : int)
  +resgatarPontos(pontos : int)
  +anonimizar()
}

class Unidade {
  +id : int
  +nome : string
  +tipo : string
  +endereco : string
  +cnpj : string
}

class Produto {
  +id : int
  +nome : string
  +descricao : string
  +preco : decimal
  +categoria : string
  +ativo : bool
}

class Estoque {
  +id : int
  +quantidade : int
  +disponivel : bool
  +temSaldo(qtd : int) : bool
  +baixar(qtd : int)
  +repor(qtd : int)
}

class Pedido {
  +id : int
  +canalPedido : CanalPedido
  +status : StatusPedido
  +valorDesconto : decimal
  +valorTotal : decimal
  +requestId : string
  +dataCriacao : datetime
  +adicionarItem(produto : Produto, quantidade : int)
  +calcularTotal() : decimal
  +aplicarDesconto(valor : decimal)
  +podeTransitarPara(novo : StatusPedido) : bool
  +atualizarStatus(novo : StatusPedido)
  +cancelar()
}

class ItemPedido {
  +id : int
  +quantidade : int
  +precoUnitario : decimal
  +subtotal() : decimal
}

class Pagamento {
  +id : int
  +metodo : string
  +status : StatusPagamento
  +gatewayTransacaoId : string
  +valor : decimal
  +payloadResposta : json
  +dataHora : datetime
  +aprovar(transacaoId : string, payload : json)
  +recusar(payload : json)
}

class HistoricoFidelidade {
  +id : int
  +tipo : TipoPontos
  +pontos : int
  +dataHora : datetime
}

class LogAuditoria {
  +id : int
  +acao : string
  +entidade : string
  +entidadeId : int
  +dataHora : datetime
  +detalhes : json
}

enum Perfil {
  CLIENTE
  ATENDENTE
  COZINHA
  GERENTE
  ADMIN
}

enum CanalPedido {
  APP
  TOTEM
  BALCAO
  PICKUP
  WEB
}

enum StatusPedido {
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum StatusPagamento {
  PENDENTE
  APROVADO
  RECUSADO
}

enum TipoPontos {
  GANHO
  RESGATE
  ESTORNO
}

Unidade "0..1" -- "0..*" Usuario : emprega
Usuario "0..1" -- "0..*" Pedido : realiza
Unidade "1" -- "0..*" Pedido : recebe
Unidade "1" -- "0..*" Estoque : possui
Produto "1" -- "0..*" Estoque : compoe
Produto "1" -- "0..*" ItemPedido : referenciado em
Pedido "1" *-- "1..*" ItemPedido : possui
Pedido "1" -- "0..*" Pagamento : gera
Usuario "1" -- "0..*" HistoricoFidelidade : acumula
Pedido "0..1" -- "0..*" HistoricoFidelidade : pontua
Usuario "0..1" -- "0..*" LogAuditoria : gera

Usuario ..> Perfil
Pedido ..> CanalPedido
Pedido ..> StatusPedido
Pagamento ..> StatusPagamento
HistoricoFidelidade ..> TipoPontos

@enduml
